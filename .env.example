# Copy to .env.local and fill in. Never commit real values.
# Variable list is defined in docs/CONTRACTS.md section 8.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- LINE ---
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Payment (PrintGo's own PromptPay; SlipOK may stay empty -> manual review, O9) ---
PLATFORM_PROMPTPAY_ID=
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# --- Business rules (defaults from DECISIONS.md: D14, O2, O3, O5) ---
PLATFORM_FEE_RATE=0.05
SHOP_RESPONSE_MINUTES=15
PAYMENT_WINDOW_MINUTES=30
# Illustrative sample values only, not real Grab prices (O5)
DELIVERY_BASE_SATANG=4000
DELIVERY_PER_KM_SATANG=1000
DELIVERY_PROVIDER=manual

# --- Web Push for shops (D17); VAPID_PRIVATE_KEY is server only ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = frontend uses in-memory mock API instead of the real one
NEXT_PUBLIC_USE_MOCK=true
# Protects /api/cron/*
CRON_SECRET=
